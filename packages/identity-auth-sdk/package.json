{
  "name": "@cesco_valle/identity-auth-sdk",
  "version": "0.2.0",
  "description": "Typed HTTP clients for the portfolio identity service: user (cookie) and admin (service-principal) surfaces.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/C3SC0-V4113/Identity-Packages.git",
    "directory": "packages/identity-auth-sdk"
  },
  "homepage": "https://github.com/C3SC0-V4113/Identity-Packages/tree/main/packages/identity-auth-sdk",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    "./user": {
      "types": "./dist/user.d.ts",
      "import": "./dist/user.js"
    },
    "./admin": {
      "types": "./dist/admin.d.ts",
      "import": "./dist/admin.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@cesco_valle/identity-contracts": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.13"
  }
}
